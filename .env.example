# Neon pooled connection URL. Server-only; use this for the application.
DATABASE_URL=

# Neon direct connection URL. Server-only; use this for migrations and pg_dump/pg_restore.
DATABASE_URL_UNPOOLED=

# Must match the secret stored in Google Apps Script Properties.
INGEST_SECRET=

# Safe default: synthetic scores are generated in memory and never written to Neon.
# Change to live only after the source spreadsheet and Neon result tables are clean.
SCOREBOARD_DATA_MODE=preview

APP_TIMEZONE=America/Chicago
NEXT_PUBLIC_SITE_URL=http://localhost:3000
