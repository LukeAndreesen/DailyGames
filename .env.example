# Supabase API values safe for the browser. RLS still controls access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase transaction-pooler URL. Server-only.
DATABASE_URL=

# Must match the secret stored in Google Apps Script Properties.
INGEST_SECRET=

# Safe default: synthetic scores are generated in memory and never written to Supabase.
# Change to live only after the source spreadsheet and Supabase result tables are clean.
SCOREBOARD_DATA_MODE=preview

APP_TIMEZONE=America/Chicago
NEXT_PUBLIC_SITE_URL=http://localhost:3000
